{
  "name": "quorum-qa",
  "version": "0.1.0",
  "description": "A quorum of AI reviewers for your pull requests. It reports only findings it can verify in your code.",
  "license": "Apache-2.0",
  "author": "Isaac Sanchez Aguilar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isanchez-aguilar/quorum-qa.git"
  },
  "homepage": "https://github.com/isanchez-aguilar/quorum-qa#readme",
  "bugs": {
    "url": "https://github.com/isanchez-aguilar/quorum-qa/issues"
  },
  "keywords": [
    "code-review",
    "ai",
    "llm",
    "qa",
    "cli",
    "gemini",
    "codex",
    "claude",
    "multi-model",
    "sarif",
    "code-review-bot",
    "pull-request",
    "static-analysis",
    "ai-code-review"
  ],
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "bin": {
    "quorum": "bin/quorum.js"
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/**/*.map",
    "src/runtime/*.cjs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
