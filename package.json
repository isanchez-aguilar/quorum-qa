{
  "name": "quorum-qa",
  "version": "0.0.0",
  "description": "A quorum of AI reviewers for your code. It reports only verified findings.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "private": true,
  "bin": {
    "quorum": "bin/quorum.js"
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/**/*.map",
    "src/runtime/*.cjs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
